{
  "name": "cajusa",
  "private": true,
  "workspaces": ["Cajusa-frontend", "Cajusa-backend"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:front": "npm --workspace Cajusa-frontend run dev",
    "dev:back": "npm --workspace Cajusa-backend run dev",
    "build:front": "npm --workspace Cajusa-frontend run build",
    "build:back": "npm --workspace Cajusa-backend run build"
  }
}
